# Paths are relative to THIS env file, not to the working directory.
RR_JUDGMENTS_PATH=dataset/ban-an
RR_TVPL_PATH=dataset/nguon-luat/thuvienphapluat-vn-vbpl
RR_PHAPDIEN_PATH=dataset/nguon-luat/phapdien-moj-gov-vn
RR_OUTPUT_DIR=outputs/rule_recall
RR_PROMPTS_FILE=docs/rule_recall_annotation_prompts.md

# Comma-separated profile names. All dataset/model connections are configured here.
RR_PROFILES=LOCAL
RR_DEFAULT_PROFILE=LOCAL
RR_LOCAL_BASE_URL=http://127.0.0.1:8010/v1
RR_LOCAL_MODEL=qwen3.5-35b-a3b
RR_LOCAL_AUTH_MODE=bearer
RR_LOCAL_API_KEY=
RR_LOCAL_OUTPUT_MODE=json_schema
RR_LOCAL_TOKEN_PARAMETER=max_tokens
RR_LOCAL_MAX_OUTPUT_TOKENS=2048
RR_LOCAL_CONTEXT_TOKENS=32768
RR_LOCAL_MAX_INPUT_CHARS=12000
RR_LOCAL_TOKEN_MARGIN=512
RR_LOCAL_TIMEOUT=180
RR_LOCAL_RETRIES=2
RR_LOCAL_RETRY_BACKOFF=1
RR_LOCAL_CONCURRENCY=1
# Leave temperature empty for models that do not accept it.
RR_LOCAL_TEMPERATURE=0
RR_LOCAL_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'
RR_LOCAL_MODALITIES='["text"]'
RR_LOCAL_INSTRUCTION_ROLE=system

# Override any role independently with another name from RR_PROFILES.
RR_PROFILE_P1=LOCAL
RR_PROFILE_P2=LOCAL
RR_PROFILE_P3=LOCAL
RR_PROFILE_P4=LOCAL
RR_PROFILE_P5=LOCAL
RR_PROFILE_P6=LOCAL
RR_PROFILE_AUGMENT=LOCAL
# Optional VLM: configure another profile with MODALITIES=["text","image"].
RR_PROFILE_P0V=
RR_VISION_MANIFEST=

# Example remote/OpenAI profile (add REMOTE to RR_PROFILES before enabling):
# RR_REMOTE_BASE_URL=https://api.openai.com/v1
# RR_REMOTE_MODEL=<your-served-model-name>
# RR_REMOTE_AUTH_MODE=bearer
# RR_REMOTE_API_KEY=
# RR_REMOTE_TOKEN_PARAMETER=max_completion_tokens
# RR_REMOTE_TEMPERATURE=
# RR_REMOTE_EXTRA_BODY={}
# RR_REMOTE_MODALITIES=["text"]
# RR_REMOTE_OUTPUT_MODE=json_schema
# RR_REMOTE_CONTEXT_TOKENS=<set-for-your-model>
# For a no-key endpoint: AUTH_MODE=none, API_KEY empty. Never send Qwen options to OpenAI.

# 0 = unlimited SCANNED input records, applied separately to each law corpus.
# Complete ingestion is recommended before preparing train/dev/test splits.
RR_LAW_MAX_RECORDS=0
RR_CASE_MAX_RECORDS=0
# Candidate annotation starts with a bounded pilot. Set 0 to annotate all selected cases.
RR_ANNOTATION_LIMIT=50
RR_CATEGORIES='["Civil"]'
# Explicit doc_name selection, otherwise cases are processed in stable ID order.
RR_CASE_IDS=[]
RR_SEED=20261115
RR_POOL_SIZE=20
RR_LINK_CANDIDATES=8
RR_MAX_ISSUES=3
RR_SENTENCE_CHUNK_SIZE=12
RR_MAX_CITATIONS=40
# Pilot budget: unread long sources become uncertain, never automatically negative.
# Set 0 to read every window; full-corpus sources may be extremely long.
RR_MAX_SOURCE_WINDOWS=8
RR_MAX_EXPANSION_ROUNDS=1
RR_VERIFIER_ENABLED=true
RR_FAIL_FAST=false
RR_TRAIN_RATIO=0.8
RR_DEV_RATIO=0.1
# CSV with case_id,family_id; checked in addition to automatic family links.
RR_FAMILY_MAP=
# JSON examples by stage; each requires split=train/dev and human_reviewed=true.
RR_FEWSHOT_FILE=
RR_OFFICIAL_DOMAINS='["vbpl.vn","vbpl.moj.gov.vn","vanban.chinhphu.vn","congbao.chinhphu.vn","phapdien.moj.gov.vn","datafiles.chinhphu.vn"]'
